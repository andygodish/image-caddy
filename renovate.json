{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/andygodish/caddy"
      ],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG CADDY_VERSION=\\\"(?<currentValue>[^\\\"]+)\\\"",
        "\\| Base image \\| `caddy:(?<currentValue>[^`]+)` \\|"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "caddy",
      "versioningTemplate": "docker"
    }
  ]
}
