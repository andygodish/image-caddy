{
	http_port 8080
	https_port 8443
	admin off
}

:8080 {
	respond /health "ok" 200
	respond "Caddy reverse proxy is running." 200
}

# Proxmox example:
#
# proxmox.home.arpa {
# 	reverse_proxy https://192.168.1.10:8006 {
# 		transport http {
# 			tls_insecure_skip_verify
# 		}
# 	}
# }

# Pi-hole example (both projects must join the homelab-proxy network):
#
# pihole.home.arpa {
# 	tls internal
# 	reverse_proxy pihole-new:80
# }
